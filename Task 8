def find_nb(m):
    n = 1
    total_volume = 0
    
    # Строим башню кубик за кубиком, пока объем не достигнет m или не превысит его
    while total_volume < m:
        total_volume += n ** 3
        if total_volume == m:
            return n
        n += 1
        
    # Если цикл закончился, а точного совпадения не было — возвращаем -1
    return -1