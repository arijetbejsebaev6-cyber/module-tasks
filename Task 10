def friend(x):
    # Создаем пустой список для наших друзей
    friends = []
    
    # Перебираем каждое имя в исходном списке
    for name in x:
        # Если длина имени ровно 4 буквы, добавляем его в список друзей
        if len(name) == 4:
            friends.append(name)
            
    return friends