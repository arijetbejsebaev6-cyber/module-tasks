def basic_op(operation, value1, value2):
    # Проверяем, какая операция передана, и выполняем её
    if operation == '+':
        return value1 + value2
    elif operation == '-':
        return value1 - value2
    elif operation == '*':
        return value1 * value2
    elif operation == '/':
        return value1 / value2